    <string name="format_help_title">Formats pris en charge</string>
    <string name="format_help_intro">Une ligne de proxy est une ligne unique qui décrit un serveur proxy : son adresse et son port, et éventuellement un nom d’utilisateur, un mot de passe et un protocole, généralement sous la forme fournie par votre fournisseur. « Analyser » ne fait que remplir le formulaire ; vérifiez les champs puis appuyez sur Enregistrer.</string>
    <string name="format_help_group_address_title">Adresse et identifiants</string>
    <string name="format_help_group_address_body">Sans protocole, l’application se connecte au proxy et le détecte en essayant HTTPS, SOCKS5 puis HTTP.</string>
    <string name="format_help_group_credentials_first_title">Identifiants en premier (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port est reconnu lorsqu’un seul ordre de champs a du sens.</string>
    <string name="format_help_group_urls_title">URL de proxy</string>
    <string name="format_help_group_urls_body">Schémas : http, https, socks5 et socks5h (enregistré comme SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protocole avant ou après</string>
    <string name="format_help_group_protocol_body">Les noms de protocole ne tiennent pas compte de la casse et sont séparés par un espace.</string>
    <string name="format_help_group_spaces_title">Champs séparés par des espaces</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], dans cet ordre.</string>
    <string name="format_help_group_csv_title">Ligne CSV ou TSV</string>
    <string name="format_help_group_csv_body">Une ligne sans en-tête : host, port, [username, password], [protocol]. Séparateurs : virgule, point-virgule ou tabulation.</string>
    <string name="format_help_group_special_title">Caractères spéciaux dans les identifiants</string>
    <string name="format_help_group_special_body">Utilisez une URL et encodez en pourcent les caractères réservés. Cet exemple a le nom d’utilisateur demo@user et le mot de passe p:ss.</string>
    <string name="format_help_rule_port">Un port est toujours requis (1–65535).</string>
    <string name="format_help_rule_ambiguous">Si une ligne correspond à la fois à host:port:user:pass et à user:pass:host:port, par exemple %1$s, choisissez l’ordre des champs avant d’enregistrer.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a et les adresses de proxy IPv6 ne sont pas pris en charge, par exemple %1$s et %2$s.</string>
    <string name="format_help_rule_credentials">En dehors des URL, les identifiants ne peuvent pas contenir « : », « @ » ni d’espaces.</string>
    <string name="format_help_rule_detect">Si le protocole ne peut pas être détecté, sélectionnez-le manuellement.</string>
    <string name="format_help_rules">Règles</string>
    <string name="format_help_examples_note">Les adresses et identifiants ci-dessus sont des exemples.</string>
