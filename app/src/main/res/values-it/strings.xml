    <string name="format_help_title">Formati supportati</string>
    <string name="format_help_intro">Una riga proxy è una singola riga che descrive un server proxy: indirizzo e porta e, facoltativamente, nome utente, password e protocollo, di solito nel formato fornito dal tuo provider. «Analizza» compila solo il modulo; controlla i campi e tocca Salva.</string>
    <string name="format_help_group_address_title">Indirizzo e credenziali</string>
    <string name="format_help_group_address_body">Senza protocollo, l’app si connette al proxy e lo rileva provando HTTPS, SOCKS5 e HTTP.</string>
    <string name="format_help_group_credentials_first_title">Prima le credenziali (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port viene riconosciuto quando ha senso un solo ordine dei campi.</string>
    <string name="format_help_group_urls_title">URL proxy</string>
    <string name="format_help_group_urls_body">Schemi: http, https, socks5 e socks5h (salvato come SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protocollo prima o dopo</string>
    <string name="format_help_group_protocol_body">I nomi di protocollo non distinguono maiuscole e minuscole e sono separati da uno spazio.</string>
    <string name="format_help_group_spaces_title">Campi separati da spazi</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], in quest’ordine.</string>
    <string name="format_help_group_csv_title">Riga CSV o TSV</string>
    <string name="format_help_group_csv_body">Una riga senza intestazione: host, port, [username, password], [protocol]. Separatori: virgola, punto e virgola o tabulazione.</string>
    <string name="format_help_group_special_title">Caratteri speciali nelle credenziali</string>
    <string name="format_help_group_special_body">Usa un URL e codifica in percentuale i caratteri riservati. Questo esempio ha nome utente demo@user e password p:ss.</string>
    <string name="format_help_rule_port">La porta è sempre obbligatoria (1–65535).</string>
    <string name="format_help_rule_ambiguous">Se una riga corrisponde sia a host:port:user:pass sia a user:pass:host:port, ad esempio %1$s, scegli l’ordine dei campi prima di salvare.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a e gli indirizzi proxy IPv6 non sono supportati, ad esempio %1$s e %2$s.</string>
    <string name="format_help_rule_credentials">Fuori dagli URL, le credenziali non possono contenere «:», «@» o spazi.</string>
    <string name="format_help_rule_detect">Se il protocollo non può essere rilevato, selezionalo manualmente.</string>
    <string name="format_help_rules">Regole</string>
    <string name="format_help_examples_note">Indirizzi e credenziali qui sopra sono esempi.</string>
