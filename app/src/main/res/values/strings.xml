    <string name="format_help_title">Supported formats</string>
    <string name="format_help_intro">A proxy string is one line that describes a proxy server: its address and port, and optionally a username, password and protocol, usually in the form your proxy provider gives it. Parse only fills the form; review the fields and press Save.</string>
    <string name="format_help_group_address_title">Address and credentials</string>
    <string name="format_help_group_address_body">Without a protocol, the app connects to the proxy and detects it, trying HTTPS, SOCKS5 and HTTP.</string>
    <string name="format_help_group_credentials_first_title">Credentials first (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port is recognized when only one field order makes sense.</string>
    <string name="format_help_group_urls_title">Proxy URLs</string>
    <string name="format_help_group_urls_body">Schemes: http, https, socks5 and socks5h (saved as SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protocol before or after</string>
    <string name="format_help_group_protocol_body">Protocol names are case-insensitive and separated by a space.</string>
    <string name="format_help_group_spaces_title">Space-separated fields</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], in this order.</string>
    <string name="format_help_group_csv_title">CSV or TSV row</string>
    <string name="format_help_group_csv_body">One row without a header: host, port, [username, password], [protocol]. Separators: comma, semicolon or tab.</string>
    <string name="format_help_group_special_title">Special characters in credentials</string>
    <string name="format_help_group_special_body">Use a URL and percent-encode reserved characters. This example has username demo@user and password p:ss.</string>
    <string name="format_help_rule_port">A port is always required (1–65535).</string>
    <string name="format_help_rule_ambiguous">If a line fits both host:port:user:pass and user:pass:host:port, for example %1$s, choose the field order before saving.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a and IPv6 proxy addresses are not supported, for example %1$s and %2$s.</string>
    <string name="format_help_rule_credentials">Outside URLs, credentials cannot contain \':\', \'@\' or spaces.</string>
    <string name="format_help_rule_detect">If the protocol cannot be detected, select it manually.</string>
    <string name="format_help_rules">Rules</string>
    <string name="format_help_examples_note">Addresses and credentials above are examples.</string>
