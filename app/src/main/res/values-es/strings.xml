    <string name="format_help_title">Formatos admitidos</string>
    <string name="format_help_intro">Una línea de proxy es una sola línea que describe un servidor proxy: su dirección y puerto y, opcionalmente, usuario, contraseña y protocolo, normalmente tal como te la da tu proveedor. «Analizar» solo rellena el formulario; revisa los campos y pulsa Guardar.</string>
    <string name="format_help_group_address_title">Dirección y credenciales</string>
    <string name="format_help_group_address_body">Sin protocolo, la app se conecta al proxy y lo detecta probando HTTPS, SOCKS5 y HTTP.</string>
    <string name="format_help_group_credentials_first_title">Credenciales primero (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port se reconoce cuando solo un orden de campos tiene sentido.</string>
    <string name="format_help_group_urls_title">URL de proxy</string>
    <string name="format_help_group_urls_body">Esquemas: http, https, socks5 y socks5h (se guarda como SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protocolo antes o después</string>
    <string name="format_help_group_protocol_body">Los nombres de protocolo no distinguen mayúsculas y se separan con un espacio.</string>
    <string name="format_help_group_spaces_title">Campos separados por espacios</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], en este orden.</string>
    <string name="format_help_group_csv_title">Fila CSV o TSV</string>
    <string name="format_help_group_csv_body">Una fila sin encabezado: host, port, [username, password], [protocol]. Separadores: coma, punto y coma o tabulador.</string>
    <string name="format_help_group_special_title">Caracteres especiales en las credenciales</string>
    <string name="format_help_group_special_body">Usa una URL y codifica en porcentaje los caracteres reservados. Este ejemplo tiene el usuario demo@user y la contraseña p:ss.</string>
    <string name="format_help_rule_port">El puerto siempre es obligatorio (1–65535).</string>
    <string name="format_help_rule_ambiguous">Si una línea encaja tanto en host:port:user:pass como en user:pass:host:port, por ejemplo %1$s, elige el orden de los campos antes de guardar.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a y las direcciones de proxy IPv6 no son compatibles, por ejemplo %1$s y %2$s.</string>
    <string name="format_help_rule_credentials">Fuera de las URL, las credenciales no pueden contener «:», «@» ni espacios.</string>
    <string name="format_help_rule_detect">Si no se puede detectar el protocolo, selecciónalo manualmente.</string>
    <string name="format_help_rules">Reglas</string>
    <string name="format_help_examples_note">Las direcciones y credenciales de arriba son ejemplos.</string>
