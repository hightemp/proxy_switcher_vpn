    <string name="format_help_title">Unterstützte Formate</string>
    <string name="format_help_intro">Eine Proxy-Zeile ist eine einzelne Zeile, die einen Proxy-Server beschreibt: Adresse und Port, optional Benutzername, Passwort und Protokoll – meist in der Form, die dein Proxy-Anbieter liefert. „Auswerten“ füllt nur das Formular aus; prüfe die Felder und tippe auf „Speichern“.</string>
    <string name="format_help_group_address_title">Adresse und Zugangsdaten</string>
    <string name="format_help_group_address_body">Ohne Protokoll verbindet sich die App mit dem Proxy und ermittelt es, indem sie HTTPS, SOCKS5 und HTTP ausprobiert.</string>
    <string name="format_help_group_credentials_first_title">Zugangsdaten zuerst (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port wird erkannt, wenn nur eine Feldreihenfolge sinnvoll ist.</string>
    <string name="format_help_group_urls_title">Proxy-URLs</string>
    <string name="format_help_group_urls_body">Schemata: http, https, socks5 und socks5h (wird als SOCKS5 gespeichert).</string>
    <string name="format_help_group_protocol_title">Protokoll davor oder danach</string>
    <string name="format_help_group_protocol_body">Protokollnamen sind unabhängig von Groß-/Kleinschreibung und durch ein Leerzeichen getrennt.</string>
    <string name="format_help_group_spaces_title">Durch Leerzeichen getrennte Felder</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], in dieser Reihenfolge.</string>
    <string name="format_help_group_csv_title">CSV- oder TSV-Zeile</string>
    <string name="format_help_group_csv_body">Eine Zeile ohne Kopfzeile: host, port, [username, password], [protocol]. Trennzeichen: Komma, Semikolon oder Tab.</string>
    <string name="format_help_group_special_title">Sonderzeichen in Zugangsdaten</string>
    <string name="format_help_group_special_body">Verwende eine URL und kodiere reservierte Zeichen mit Prozentkodierung. Dieses Beispiel hat den Benutzernamen demo@user und das Passwort p:ss.</string>
    <string name="format_help_rule_port">Ein Port ist immer erforderlich (1–65535).</string>
    <string name="format_help_rule_ambiguous">Passt eine Zeile zu host:port:user:pass und zu user:pass:host:port, zum Beispiel %1$s, wähle vor dem Speichern die Feldreihenfolge.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a und IPv6-Proxyadressen werden nicht unterstützt, zum Beispiel %1$s und %2$s.</string>
    <string name="format_help_rule_credentials">Außerhalb von URLs dürfen Zugangsdaten kein „:“, „@“ oder Leerzeichen enthalten.</string>
    <string name="format_help_rule_detect">Wenn das Protokoll nicht ermittelt werden kann, wähle es manuell aus.</string>
    <string name="format_help_rules">Regeln</string>
    <string name="format_help_examples_note">Die Adressen und Zugangsdaten oben sind Beispiele.</string>
