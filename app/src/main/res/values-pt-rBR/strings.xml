    <string name="format_help_title">Formatos compatíveis</string>
    <string name="format_help_intro">Uma linha de proxy é uma única linha que descreve um servidor proxy: endereço e porta e, opcionalmente, usuário, senha e protocolo, geralmente no formato que o seu provedor entrega. \"Analisar\" só preenche o formulário; revise os campos e toque em Salvar.</string>
    <string name="format_help_group_address_title">Endereço e credenciais</string>
    <string name="format_help_group_address_body">Sem protocolo, o app se conecta ao proxy e o detecta testando HTTPS, SOCKS5 e HTTP.</string>
    <string name="format_help_group_credentials_first_title">Credenciais primeiro (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port é reconhecido quando só uma ordem de campos faz sentido.</string>
    <string name="format_help_group_urls_title">URLs de proxy</string>
    <string name="format_help_group_urls_body">Esquemas: http, https, socks5 e socks5h (salvo como SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protocolo antes ou depois</string>
    <string name="format_help_group_protocol_body">Nomes de protocolo não diferenciam maiúsculas e são separados por um espaço.</string>
    <string name="format_help_group_spaces_title">Campos separados por espaço</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], nesta ordem.</string>
    <string name="format_help_group_csv_title">Linha CSV ou TSV</string>
    <string name="format_help_group_csv_body">Uma linha sem cabeçalho: host, port, [username, password], [protocol]. Separadores: vírgula, ponto e vírgula ou tab.</string>
    <string name="format_help_group_special_title">Caracteres especiais nas credenciais</string>
    <string name="format_help_group_special_body">Use uma URL e codifique em porcentagem os caracteres reservados. Este exemplo tem o usuário demo@user e a senha p:ss.</string>
    <string name="format_help_rule_port">A porta é sempre obrigatória (1–65535).</string>
    <string name="format_help_rule_ambiguous">Se uma linha servir tanto para host:port:user:pass quanto para user:pass:host:port, por exemplo %1$s, escolha a ordem dos campos antes de salvar.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a e endereços de proxy IPv6 não são compatíveis, por exemplo %1$s e %2$s.</string>
    <string name="format_help_rule_credentials">Fora de URLs, as credenciais não podem conter \":\", \"@\" ou espaços.</string>
    <string name="format_help_rule_detect">Se o protocolo não puder ser detectado, selecione-o manualmente.</string>
    <string name="format_help_rules">Regras</string>
    <string name="format_help_examples_note">Os endereços e credenciais acima são exemplos.</string>
