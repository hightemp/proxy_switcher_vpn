    <string name="format_help_title">Obsługiwane formaty</string>
    <string name="format_help_intro">Wiersz proxy to jedna linia opisująca serwer proxy: adres i port oraz opcjonalnie nazwę użytkownika, hasło i protokół, zwykle w postaci podanej przez dostawcę proxy. „Analizuj” tylko wypełnia formularz; sprawdź pola i naciśnij Zapisz.</string>
    <string name="format_help_group_address_title">Adres i dane logowania</string>
    <string name="format_help_group_address_body">Bez protokołu aplikacja łączy się z proxy i wykrywa go, próbując HTTPS, SOCKS5 i HTTP.</string>
    <string name="format_help_group_credentials_first_title">Najpierw dane logowania (proxyline)</string>
    <string name="format_help_group_credentials_first_body">username:password:host:port jest rozpoznawany, gdy sensowna jest tylko jedna kolejność pól.</string>
    <string name="format_help_group_urls_title">Adresy URL proxy</string>
    <string name="format_help_group_urls_body">Schematy: http, https, socks5 i socks5h (zapisywany jako SOCKS5).</string>
    <string name="format_help_group_protocol_title">Protokół przed lub po</string>
    <string name="format_help_group_protocol_body">Nazwy protokołów nie rozróżniają wielkości liter i są oddzielone spacją.</string>
    <string name="format_help_group_spaces_title">Pola oddzielone spacjami</string>
    <string name="format_help_group_spaces_body">host port [username password] [protocol], w tej kolejności.</string>
    <string name="format_help_group_csv_title">Wiersz CSV lub TSV</string>
    <string name="format_help_group_csv_body">Jeden wiersz bez nagłówka: host, port, [username, password], [protocol]. Separatory: przecinek, średnik lub tabulator.</string>
    <string name="format_help_group_special_title">Znaki specjalne w danych logowania</string>
    <string name="format_help_group_special_body">Użyj adresu URL i zakoduj procentowo znaki zastrzeżone. W tym przykładzie nazwa użytkownika to demo@user, a hasło p:ss.</string>
    <string name="format_help_rule_port">Port jest zawsze wymagany (1–65535).</string>
    <string name="format_help_rule_ambiguous">Jeśli wiersz pasuje zarówno do host:port:user:pass, jak i do user:pass:host:port, na przykład %1$s, przed zapisaniem wybierz kolejność pól.</string>
    <string name="format_help_rule_unsupported">SOCKS4/SOCKS4a i adresy proxy IPv6 nie są obsługiwane, na przykład %1$s i %2$s.</string>
    <string name="format_help_rule_credentials">Poza adresami URL dane logowania nie mogą zawierać „:”, „@” ani spacji.</string>
    <string name="format_help_rule_detect">Jeśli nie da się wykryć protokołu, wybierz go ręcznie.</string>
    <string name="format_help_rules">Zasady</string>
